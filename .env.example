# LoRA Bench — environment template
# Copy to .env and fill in. Never commit the real .env file.
#
# Note: this project runs its GPU steps in Google Colab, not locally or in
# Claude Code's sandbox. This .env is for repo-side tooling only (data-prep
# scripts, unit tests, any local linting/CI). Inside the actual Colab
# notebook, set the same Hugging Face token via Colab's Secrets panel
# (key icon, left sidebar) instead of a committed file.

# Hugging Face access token (read scope is enough).
# Free tier, no card required. Needed to download the base open model and,
# if it's gated, to authenticate that you've accepted its license.
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Optional, only if you choose to use it ---

# Weights & Biases API key — only needed if you wire in W&B run tracking for
# the LoRA hyperparameter sweep (not required by the MVP non-negotiables).
# Free tier (personal account), no card required.
# Get one at: https://wandb.ai/authorize
# WANDB_API_KEY=
